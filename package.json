{
  "name": "@ftrdtodev/pi-mono",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "prepare": "bun effect-tsgo patch --typescript --oxlint",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset version && bun run publish:packages && changeset git-tag",
    "publish:tui": "cd packages/tui && bun publish --ignore-scripts",
    "publish:tracker": "cd packages/tracker && bun publish --ignore-scripts",
    "publish:inquiry": "cd packages/inquiry && bun publish --ignore-scripts",
    "publish:qrspi": "cd packages/qrspi && bun run prepack && bun publish --ignore-scripts",
    "publish:packages": "bun run publish:tui && bun run publish:tracker && bun run publish:inquiry && bun run publish:qrspi"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@effect/tsgo": "catalog:effect",
    "@types/bun": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "catalogs": {
    "effect": {
      "@effect/platform-node": "4.0.0",
      "@effect/platform-node-shared": "4.0.0",
      "@effect/tsgo": "0.47.2",
      "@effect/vitest": "4.0.0",
      "effect": "4.0.0"
    },
    "pi": {
      "@earendil-works/pi-ai": "1.0.0",
      "@earendil-works/pi-coding-agent": "1.0.0",
      "@earendil-works/pi-tui": "1.0.0",
      "typebox": "1.3.34"
    },
    "tooling": {
      "@types/bun": "latest",
      "oxfmt": "^0.63.0",
      "oxlint": "1.82.0",
      "oxlint-tsgolint": "7.0.2001",
      "typescript": "7.0.2",
      "vitest": "^4.1.10"
    }
  }
}
