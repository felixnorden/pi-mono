{
  "name": "@ftrdotdev/pi-tracker",
  "private": true,
  "description": "Session-persistent todolist extension for Pi",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && oxlint --type-aware -A all -D typescript/unbound-method",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt -c oxfmt.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "catalog:pi",
    "@effect/platform-node": "catalog:effect",
    "@ftrdotdev/pi-tui": "workspace:*",
    "effect": "catalog:effect",
    "typebox": "catalog:pi"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "@types/bun": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:pi",
    "@earendil-works/pi-tui": "catalog:pi"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
