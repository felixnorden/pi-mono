{
  "name": "@ftrdotdev/pi-tui",
  "version": "0.1.0",
  "description": "House TUI components and the pi interface extension: themed boxes, a pure box-frame model, and the header/footer/editor/settings/preview chrome",
  "keywords": [
    "components",
    "effect",
    "extension",
    "pi",
    "pi-coding-agent",
    "pi-package",
    "terminal",
    "tui"
  ],
  "homepage": "https://github.com/felixnorden/pi-mono#readme",
  "bugs": {
    "url": "https://github.com/felixnorden/pi-mono/issues"
  },
  "license": "MIT",
  "author": "Felix Nordén <felixnorden@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixnorden/pi-mono.git",
    "directory": "packages/tui"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./box-frame": {
      "types": "./src/frame/box-frame.ts",
      "default": "./src/frame/box-frame.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && oxlint --type-aware -A all -D typescript/unbound-method",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:effect",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "@types/bun": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
